{
  "sections": [
    {
      "id": "female_hormones_age",
      "title": "Female Hormones & Age",
      "icon": "user-female",
      "description": "Primary ovarian reserve, pituitary endocrine axis and maternal chronological age",
      "features": [
        {
          "name": "Female_Age",
          "label": "Female Age",
          "unit": "years",
          "placeholder": "e.g. 32",
          "step": "1",
          "min": 18,
          "max": 55,
          "tooltip": "Age of female partner at egg retrieval"
        },
        {
          "name": "Female_Baseline_FSH",
          "label": "Baseline FSH",
          "unit": "mIU/mL",
          "placeholder": "e.g. 6.8",
          "step": "0.1",
          "min": 0,
          "max": 50,
          "tooltip": "Follicle-Stimulating Hormone on day 2-3 of cycle"
        },
        {
          "name": "Female_Baseline_PRL",
          "label": "Baseline Prolactin (PRL)",
          "unit": "ng/mL",
          "placeholder": "e.g. 15.2",
          "step": "0.1",
          "min": 0,
          "max": 200,
          "tooltip": "Serum prolactin concentration"
        },
        {
          "name": "Female_Baseline_T",
          "label": "Baseline Testosterone (T)",
          "unit": "ng/dL",
          "placeholder": "e.g. 0.35",
          "step": "0.01",
          "min": 0,
          "max": 10,
          "tooltip": "Total serum testosterone"
        },
        {
          "name": "Female_Baseline_P",
          "label": "Baseline Progesterone (P)",
          "unit": "ng/mL",
          "placeholder": "e.g. 0.45",
          "step": "0.01",
          "min": 0,
          "max": 20,
          "tooltip": "Basal serum progesterone"
        },
        {
          "name": "Female_AMH",
          "label": "Anti-Müllerian Hormone (AMH)",
          "unit": "ng/mL",
          "placeholder": "e.g. 2.85",
          "step": "0.01",
          "min": 0,
          "max": 30,
          "tooltip": "Ovarian reserve biomarker"
        }
      ]
    },
